      "title": "Como Funciona",
      "output": {
        "generic": [
          {
            "values": [
              {
                "text": "⚙️ O OrbitAlert funciona assim: 1) Satélites da NASA, ESA e INPE capturam dados a cada 2 horas. 2) Nossos algoritmos analisam temperatura, umidade e vegetação. 3) O sistema calcula o risco de 0 a 100. 4) Se crítico, você recebe alerta via Telegram e Webchat!"
              }
            ],
            "response_type": "text",
            "selection_policy": "sequential"
          }
        ]
      },
